# PostgreSQL connection URL for app runtime (Session Mode pooler on port 5432 or direct)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devkics?schema=public"

# Optional direct connection URL for migrations (Prisma CLI / migrate deploy on port 5432)
# Required on Supabase when DATABASE_URL points to a transaction pooler
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/devkics?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="DevKics <notifications@your-verified-domain.example>"

# Optional: enables an in-process background retry loop (setInterval, safe only
# because the app runs as one long-lived Bun process in Docker) that re-attempts
# delivery of any queued/undelivered EMAIL notifications. Leave unset/0 to
# disable and rely on the manual admin endpoint POST /api/notifications/deliver-queued.
EMAIL_QUEUE_RETRY_INTERVAL_MS="300000"

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
SUPABASE_GALLERY_BUCKET="devkics-gallery"

# Initial Production Administrator provisioning (consumed by prisma/prod-seed.mjs)
PROD_ADMIN_NAME="DevKics Platform Admin"
PROD_ADMIN_EMAIL="admin@your-production-domain.example"
PROD_ADMIN_PASSWORD="replace-with-a-very-strong-passphrase"

POSTGRES_DB="devkics"
POSTGRES_USER="devkics"
POSTGRES_PASSWORD="devkics"
